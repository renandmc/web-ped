{
    "name": "renandmc/web-ped",
    "type": "project",
    "description": "Sistema WEB PED de tiragem de pedidos online",
    "keywords": [
        "framework",
        "laravel",
        "pedidos",
        "orders",
        "online",
        "tiragem",
        "pedidos"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "fakerphp/faker": "^1.24",
        "guzzlehttp/guzzle": "^7.17",
        "jeroennoten/laravel-adminlte": "^3.16",
        "laravel/framework": "^12.71",
        "laravel/sanctum": "^4.5",
        "laravel/tinker": "^3.2",
        "laravel/ui": "^4.6",
        "symfony/http-client": "^7.1",
        "symfony/mailgun-mailer": "^7.1",
        "symfony/postmark-mailer": "^7.1"
    },
    "require-dev": {
        "laravel/sail": "^1.71",
        "laravel/telescope": "^5.29",
        "lucascudo/laravel-pt-br-localization": "^3.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^12.5",
        "spatie/laravel-ignition": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
